# Copy this file to ".env" and fill in the values. Never commit .env to GitHub.

# PostgreSQL connection string from your database provider (Neon or Supabase).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# 32+ random characters used to protect sign-in cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# First Admin account, created by "npx prisma db seed".
ADMIN_PHONE=""
ADMIN_NAME="Festus Ozee"
ADMIN_TEMP_PASSWORD=""
