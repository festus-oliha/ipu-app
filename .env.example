# Copy this file to ".env" and fill in the values. Never commit .env to GitHub.

# ── Supabase database ───────────────────────────────────────────────
# In Supabase: open your project → click "Connect" at the top → choose the strings below.
# Replace [YOUR-PASSWORD] with your database password. If the password has
# symbols such as @ # % / ? : in it, it must be URL-encoded (e.g. @ becomes %40),
# so it is simplest to use a password of only letters and numbers.

# Transaction pooler (port 6543) — used by the app while it runs.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Session pooler (port 5432) — used to create and change tables (migrations).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Sign-in security ────────────────────────────────────────────────
# 32+ random characters used to protect sign-in cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── First Admin account, created by "npm run db:seed" ───────────────
ADMIN_PHONE=""
ADMIN_NAME="Festus Ozee"
ADMIN_TEMP_PASSWORD=""

# ── Receipt files (Supabase Storage) ────────────────────────────────
# In Supabase: Project Settings → API. Copy the Project URL and the
# "service_role" secret key. Keep the key secret: it is used only by the app's
# server, never in the browser. Leave both empty on your computer to keep
# uploaded receipts in a local ".uploads" folder instead.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── SMS (leave SMS_PROVIDER empty until the union picks a provider) ──
# Messages wait in the app's outbox (Office → More → Messages) until this is set.
# "termii" = Termii (termii.com). "log" = test mode, nothing is really sent.
SMS_PROVIDER=""
TERMII_API_KEY=""
# registered sender name, e.g. "IPU" (3–11 letters)
TERMII_SENDER_ID=""
# leave empty unless Termii gives you a different base URL
TERMII_BASE_URL=""
# empty = "dnd" (reaches numbers on Do-Not-Disturb)
TERMII_CHANNEL=""
# naira per SMS page, e.g. 5 — used to show SMS spend
SMS_UNIT_COST=""

# ── Email (guarantor reports, monthly backup) ───────────────────────
# Gmail: smtp.gmail.com, port 465, the Gmail address, and an "app password"
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# e.g. Iyobor Progressive Union <iyoborpu@gmail.com>
EMAIL_FROM=""
# where the monthly Excel backup goes (besides the Admin's email)
BACKUP_EMAIL=""

# ── Hourly reminders (live site only) ───────────────────────────────
# Any 32+ random characters; Netlify's hourly function sends it to the app.
CRON_SECRET=""
